# Copy to .env.backend on the app server and fill in real values.
NODE_ENV=production
PORT=8000
LOG_LEVEL=info

# Use the DB server's PRIVATE IP (EC2 console -> instance -> Private IPv4 address).
DATABASE_URL=postgresql://hireflow:change-me-strong-db-password@<db-private-ip>:5432/jobboard

# New random secret for production (don't reuse your local one):
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# The URL people open in the browser
CORS_ORIGIN=http://<app-public-ip>

# S3: no keys here - the EC2 instance's IAM role gives access.
AWS_REGION=us-east-1
S3_BUCKET=jobboard-hireflow
