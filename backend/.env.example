# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Your local Postgres (the database where you created the tables in pgAdmin)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/jobboard

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# Frontend origin allowed by CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Optional: resume upload to S3. Leave empty to disable uploads.
# Credentials come from `aws configure` locally, or the EC2 instance IAM role.
AWS_REGION=ap-south-1
S3_BUCKET=
